# Frontend: "live" usa o backend local. "mock" mantém a demonstração isolada.
VITE_API_MODE=live
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3333
VITE_PAYMENT_RETURN_URL=http://localhost:5173/pagamento

# Backend
SERVER_PORT=3333
DATABASE_PATH=./data/app.db
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3333
ORDER_EXPIRATION_MINUTES=15

# Em desenvolvimento, os providers mock não chamam serviços externos.
TICKET_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Produção/live
TICKET_API_BASE_URL=http://66.94.99.64:9090
# true libera compra com a origem HTTP acima; CPF e telefone trafegam sem TLS.
TICKET_API_ALLOW_HTTP=false
# Origem das imagens de banner_sorteiocap/banner_sorteioesp (caminhos relativos em /concurso/atual).
TICKET_BANNER_BASE_URL=http://solidariedadesorte.ddns.net:8080
TICKET_ESTABLISHMENT_ID=
# Reserva externa na coluna bilhete.reservado: none (padrão, só reserva local), mock ou live.
# live só quando a API de bilhetes publicar PUT/GET de reserva. O prazo deve ser igual
# ao configurado na API de bilhetes e maior que ORDER_EXPIRATION_MINUTES.
TICKET_RESERVATION_PROVIDER=none
TICKET_RESERVATION_TTL_MINUTES=30
INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_HANDLE=

# Painel /admin: cria o primeiro administrador se ainda não houver nenhum.
# Senha com pelo menos 12 caracteres. Depois do primeiro acesso, troque a senha no painel
# e remova estas variáveis.
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=

# E-mail dos códigos de verificação do login de cliente.
# mock: não envia e aceita sempre o código 000000 (só desenvolvimento e testes).
# smtp: qualquer SMTP (Gmail com senha de app, Brevo, Resend). SMTP_SECURE=true para porta 465.
MAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sol da Sorte <nao-responda@exemplo.com.br>"
