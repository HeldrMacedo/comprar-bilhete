# Frontend: "live" usa o backend local. "mock" mantém a demonstração isolada.
VITE_API_MODE=live
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3333
VITE_PAYMENT_RETURN_URL=http://localhost:5173/pagamento

# Backend
SERVER_PORT=3333
DATABASE_PATH=./data/app.db
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3333
ORDER_EXPIRATION_MINUTES=15

# Em desenvolvimento, os providers mock não chamam serviços externos.
TICKET_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Produção/live
TICKET_API_BASE_URL=http://66.94.99.64:9090
# true libera compra com a origem HTTP acima; CPF e telefone trafegam sem TLS.
TICKET_API_ALLOW_HTTP=false
TICKET_ESTABLISHMENT_ID=
# Reserva externa na coluna bilhete.reservado: none (padrão, só reserva local), mock ou live.
# live só quando a API de bilhetes publicar PUT/GET de reserva. O prazo deve ser igual
# ao configurado na API de bilhetes e maior que ORDER_EXPIRATION_MINUTES.
TICKET_RESERVATION_PROVIDER=none
TICKET_RESERVATION_TTL_MINUTES=30
INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io
INFINITEPAY_HANDLE=
